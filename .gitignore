# ===== 上传与临时文件（保留 .gitkeep 占位）=====
backend/static/upload/*
!backend/static/upload/.gitkeep
backend/temp_upload/*
!backend/temp_upload/.gitkeep

# ===== 运行日志（保留 .gitkeep 占位）=====
